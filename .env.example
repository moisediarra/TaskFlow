# Docker Compose settings. Copy to .env (git-ignored) and replace every "change-me".

# PostgreSQL password for the "taskflow" database user.
POSTGRES_PASSWORD=change-me
# HMAC key for access tokens: a random string of at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Public URL of the app (used for CORS, WebSocket origins and password-reset links) and its host port.
APP_PUBLIC_URL=http://localhost:8090
APP_PORT=8090
# Set to true when the app is served over HTTPS.
APP_COOKIE_SECURE=false
# Time zone used to decide what is "due today" and "overdue".
APP_TIMEZONE=UTC
# Host port for the database (used when running the backend outside Docker).
DB_PORT=5433

# First IT Manager account, created at startup if it does not exist yet.
APP_BOOTSTRAP_ADMIN_EMAIL=it.manager@taskflow.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Optional demo data (users, projects, tasks) for a first look. Demo users share this password.
APP_SEED_DEMO=false
APP_SEED_DEMO_PASSWORD=
